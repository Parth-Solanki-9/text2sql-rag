# ─── Ollama (local LLM — no API key needed) ──────────────────────────────────
# Install Ollama: https://ollama.ai
# Then pull a model: ollama pull qwen2.5-coder:7b
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434

# ─── Database ─────────────────────────────────────────────────────────────────
# MySQL:      mysql+pymysql://user:password@localhost:3306/mydb
# PostgreSQL: postgresql+psycopg://user:password@localhost:5432/mydb
# SQLite:     sqlite:///data/demo.db
DEFAULT_SQL_DIALECT=sqlite
DATABASE_URL=sqlite:///data/demo.db

# ─── App settings ─────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=6
MAX_RESULT_ROWS=200
QUERY_TIMEOUT_SECONDS=30
MAX_REPAIR_ATTEMPTS=1
LOG_LEVEL=INFO
